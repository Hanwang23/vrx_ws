Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: 显示项
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /PointCloud21
      Splitter Ratio: 0.5
    Tree Height: 560
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: 视图
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.24
      Cell Size: 2
      Class: rviz_default_plugins/Grid
      Color: 55; 105; 125
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: 水面参考网格
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: -1.8
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomous_usv/debug_markers
      Name: 任务、规划与控制标记
      Namespaces:
        actual_trajectory: true
        controller_status: true
        cross_track_error: true
        dynamic_vessels: true
        ilos_nominal_heading: false
        mission_route: true
        mission_waypoints: true
        motion_vectors: true
        navigation_limits: true
        planned_path: true
        planner_health: true
        safety_corridor: true
        selected_heading: true
        sensor_health: true
        sensor_legend: true
        target_direction: false
        thrusters: false
        vessel_reference: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomous_usv/buoy_candidates
      Name: 浮标候选 (激光聚类)
      Namespaces:
        {}
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 90; 255; 120
      Color Transformer: FlatColor
      Decay Time: 0.25
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: 二维激光雷达回波 (130 m)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.10
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wamv/sensors/lidars/lidar_wamv_sensor/scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.28
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: 局部规划地图 (灰=已知/黑=障碍)
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomous_usv/rolling_grid
      Update Topic: /autonomous_usv/rolling_grid_updates
      Use Timestamp: false
      Value: false
    - Alpha: 0.55
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: -2
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 175; 185; 195
      Color Transformer: FlatColor
      Decay Time: 0.35
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 80; 45
      Max Intensity: 4096
      Min Color: 30; 150; 255
      Min Intensity: 0
      Name: WAM-V 三维激光雷达
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wamv/sensors/lidars/lidar_wamv_sensor/points
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 8; 25; 36
    Fixed Frame: wamv/wamv/base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: 船体局部任务视图
      Near Clip Distance: 0.01
      Scale: 14
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 14
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: true
  Hide Right Dock: true
  Views:
    collapsed: false
  Width: 1440
  X: 80
  Y: 60
